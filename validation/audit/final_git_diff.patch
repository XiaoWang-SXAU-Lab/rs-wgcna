diff --git a/examples/audit_matrix.rs b/examples/audit_matrix.rs
new file mode 100644
index 0000000..91cc84a
--- /dev/null
+++ b/examples/audit_matrix.rs
@@ -0,0 +1,198 @@
+// TEST-ONLY parameterized extension of src/main.rs. Generated by validation/audit/prepare_matrix.py.
+//! Internal parity harness (not a user-facing CLI).
+//!
+//! Reads an expression matrix (plus optional colors / trait files) and writes
+//! cor / adjacency / TOM / SFT / eigengenes / kME / module-trait as TSV so they
+//! can be diffed against the R reference (scripts/r_reference.R).
+
+use std::env;
+use std::io::Write;
+
+use faer::Mat;
+use rs_wgcna::adjacency::adjacency;
+use rs_wgcna::correlation::pearson;
+use rs_wgcna::eigengene::module_eigengene;
+use rs_wgcna::io::{read_expression, read_trait};
+use rs_wgcna::kme::kme;
+use rs_wgcna::module_trait::module_trait_cor;
+use rs_wgcna::network::{NetworkType, TomDenom, TomType};
+use rs_wgcna::sft::pick_soft_threshold;
+use rs_wgcna::tom::tom_from_cor;
+
+fn fmt(v: f64) -> String {
+    if v.is_nan() {
+        "NA".to_string()
+    } else {
+        format!("{v:.17}")
+    }
+}
+
+fn write_mat(
+    path: &str,
+    m: &Mat<f64>,
+    row_names: &[String],
+    col_names: &[String],
+) -> std::io::Result<()> {
+    let mut f = std::fs::File::create(path)?;
+    write!(f, "ID")?;
+    for c in col_names {
+        write!(f, "\t{c}")?;
+    }
+    writeln!(f)?;
+    for i in 0..m.nrows() {
+        write!(f, "{}", row_names[i])?;
+        for j in 0..m.ncols() {
+            write!(f, "\t{}", fmt(m[(i, j)]))?;
+        }
+        writeln!(f)?;
+    }
+    Ok(())
+}
+
+fn read_lines(path: &str) -> Vec<String> {
+    std::fs::read_to_string(path)
+        .unwrap_or_default()
+        .lines()
+        .map(|l| l.trim().to_string())
+        .filter(|l| !l.is_empty())
+        .collect()
+}
+
+fn main() {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 3 {
+        eprintln!("usage: rs-wgcna <expression.tsv> <power> <outdir> [colors.txt] [trait.tsv]");
+        std::process::exit(2);
+    }
+    let expr_path = &args[1];
+    let power: f64 = args[2].parse().expect("power");
+    let outdir = &args[3];
+    let colors_path = args.get(4);
+    let trait_path = args.get(5);
+
+    std::fs::create_dir_all(outdir).expect("create outdir");
+
+    let exp = read_expression(expr_path).expect("read expression matrix");
+    eprintln!(
+        "loaded {} genes x {} samples",
+        exp.n_genes(),
+        exp.n_samples()
+    );
+
+    let threads = std::thread::available_parallelism()
+        .map(|n| n.get())
+        .unwrap_or(1);
+    let nt = NetworkType::from_str(&args[6]).unwrap();
+    let tt = TomType::from_str(&args[7]).unwrap();
+    let td = TomDenom::from_str(&args[8]).unwrap();
+    let deep: usize = args[9].parse().unwrap();
+    let merge: f64 = args[10].parse().unwrap();
+
+    // --- cor / adjacency / TOM ---
+    let cor = pearson(&exp.data, threads).expect("correlation");
+    write_mat(&format!("{outdir}/cor.tsv"), &cor, &exp.genes, &exp.genes).expect("write cor");
+
+    let adj = adjacency(&cor, power, nt);
+    write_mat(&format!("{outdir}/adjacency.tsv"), &adj, &exp.genes, &exp.genes)
+        .expect("write adjacency");
+
+    let tom = tom_from_cor(&cor, power, nt, tt, td, threads);
+    write_mat(&format!("{outdir}/tom.tsv"), &tom, &exp.genes, &exp.genes).expect("write tom");
+
+    let diss = Mat::from_fn(tom.nrows(), tom.ncols(), |i,j| 1.0-tom[(i,j)]);
+    let tree = rs_wgcna::hclust::hclust_average(&diss);
+    let labs = rs_wgcna::cutree::cutree_hybrid(&tree.merge,&tree.height,&diss,20,deep,0.995,true,true);
+    let mut f = std::fs::File::create(format!("{outdir}/tree.tsv")).unwrap();
+    writeln!(f,"ID\tleft\tright\theight").unwrap();
+    for (i, ((l,r),h)) in tree.merge.iter().zip(tree.height.iter()).enumerate() { writeln!(f,"{}\t{}\t{}\t{:.17}",i+1,l,r,h).unwrap(); }
+    let mut f = std::fs::File::create(format!("{outdir}/dynamic.tsv")).unwrap();
+    writeln!(f,"ID\tlabel").unwrap();
+    for (g,l) in exp.genes.iter().zip(labs.iter()) {writeln!(f,"{}\t{}",g,l).unwrap();}
+    let conn = Mat::from_fn(adj.nrows(),1,|i,_| (0..adj.ncols()).filter(|&j| j!=i).map(|j|adj[(i,j)]).sum::<f64>());
+    write_mat(&format!("{outdir}/connectivity.tsv"), &conn, &exp.genes, &["total".into()]).unwrap();
+    // --- soft threshold (fit indices) ---
+    let power_vector: Vec<f64> = (1..=10)
+        .map(|p| p as f64)
+        .chain((12..=20).step_by(2).map(|p| p as f64))
+        .collect();
+    let (_, sft_rows) = pick_soft_threshold(&cor, nt, &power_vector, 0.85, 10, false);
+    {
+        let mut f = std::fs::File::create(format!("{outdir}/sft.tsv")).expect("create sft");
+        writeln!(f, "Power\tR.sq\tslope\ttruncated.R.sq\tmean.k\tmedian.k\tmax.k").unwrap();
+        for r in &sft_rows {
+            writeln!(
+                f,
+                "{}\t{}\t{}\t{}\t{}\t{}\t{}",
+                r[0], r[1], r[2], r[3], r[4], r[5], r[6]
+            )
+            .unwrap();
+        }
+    }
+
+    // --- eigengenes + kME (require colors) ---
+    if let Some(cp) = colors_path {
+        let colors = read_lines(cp);
+        assert_eq!(colors.len(), exp.n_genes(), "colors length != n_genes");
+        let mut modules: Vec<&String> = colors.iter().collect();
+        modules.sort();
+        modules.dedup();
+
+        let g = exp.n_genes();
+        let n = exp.n_samples();
+        let k = modules.len();
+        let mut mes = Mat::<f64>::zeros(n, k);
+        let mut mod_cols: Vec<String> = Vec::with_capacity(k);
+        for (mi, m) in modules.iter().enumerate() {
+            let idx: Vec<usize> = (0..g).filter(|&i| &colors[i] == *m).collect();
+            let me = module_eigengene(&exp.data, &idx);
+            for j in 0..n {
+                mes[(j, mi)] = me[j];
+            }
+            mod_cols.push((*m).clone());
+        }
+        write_mat(
+            &format!("{outdir}/eigengenes.tsv"),
+            &mes,
+            &exp.samples,
+            &mod_cols,
+        )
+        .expect("write eigengenes");
+
+        let km = kme(&exp.data, &mes);
+        write_mat(&format!("{outdir}/kme.tsv"), &km, &exp.genes, &mod_cols).expect("write kme");
+
+        // --- module-trait (require trait) ---
+        if let Some(tp) = trait_path {
+            let (_samples, traits, tdata) = read_trait(tp).expect("read trait");
+            let (cor, p) = module_trait_cor(&mes, &tdata);
+            write_mat(&format!("{outdir}/module_trait_cor.tsv"), &cor, &mod_cols, &traits)
+                .expect("write mt cor");
+            write_mat(&format!("{outdir}/module_trait_p.tsv"), &p, &mod_cols, &traits)
+                .expect("write mt p");
+        }
+    }
+
+    // --- full module detection (blockwiseModules single block) ---
+    let min_module_size = 20usize.min(exp.n_genes() / 2);
+    let module_colors = rs_wgcna::pipeline::blockwise_modules_single(
+        &exp.data,
+        power,
+        nt,
+        tt,
+        td,
+        min_module_size,
+        merge,
+        deep,
+        0.995,
+        threads,
+    );
+    {
+        let mut f =
+            std::fs::File::create(format!("{outdir}/module_colors.tsv")).expect("create colors");
+        for c in &module_colors {
+            writeln!(f, "{c}").unwrap();
+        }
+    }
+
+    eprintln!("done.");
+}
diff --git a/examples/audit_perf.rs b/examples/audit_perf.rs
new file mode 100644
index 0000000..5b3c91b
--- /dev/null
+++ b/examples/audit_perf.rs
@@ -0,0 +1,164 @@
+// TEST-ONLY benchmark with explicit thread control; otherwise identical timing boundaries.
+//! Real-data benchmark: FPKM -> log10(x+1) -> MAD top-8000 -> WGCNA ->
+//! module-trait. Writes results + per-step timings for the Quarto report.
+
+use std::time::Instant;
+
+use faer::Mat;
+use rs_wgcna::correlation::pearson;
+use rs_wgcna::eigengene::module_eigengene;
+use rs_wgcna::filter::{normalize, top_genes_by, FilterMethod, NormalizeMethod};
+use rs_wgcna::io::{read_expression, read_trait};
+use rs_wgcna::module_trait::module_trait_cor;
+use rs_wgcna::network::{NetworkType, TomDenom, TomType};
+use rs_wgcna::pipeline::blockwise_modules_single;
+use rs_wgcna::tom::tom_from_cor;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let fpkmpath = &args[1];
+    let traitpath = &args[2];
+    let outdir = &args[3];
+    let n_keep: usize = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(8000);
+    std::fs::create_dir_all(outdir).unwrap();
+
+    let threads: usize = std::env::var("AUDIT_THREADS").unwrap_or("8".into()).parse().unwrap();
+    rayon::ThreadPoolBuilder::new().num_threads(threads).build_global().unwrap();
+    let mut timings: Vec<(String, f64)> = Vec::new();
+
+    // 1. read + normalize
+    let t = Instant::now();
+    let exp = read_expression(fpkmpath).unwrap();
+    let norm = normalize(&exp.data, NormalizeMethod::Log10p1);
+    timings.push(("log10_normalize".into(), t.elapsed().as_secs_f64()));
+
+    // 2. MAD top-N
+    let t = Instant::now();
+    let idx = top_genes_by(&norm, n_keep, FilterMethod::Mad);
+    let g = idx.len();
+    let n = norm.ncols();
+    let mut filtered = Mat::<f64>::zeros(g, n);
+    for (r, &i) in idx.iter().enumerate() {
+        for j in 0..n {
+            filtered[(r, j)] = norm[(i, j)];
+        }
+    }
+    let filtered_genes: Vec<String> = idx.iter().map(|&i| exp.genes[i].clone()).collect();
+    timings.push(("mad_topN".into(), t.elapsed().as_secs_f64()));
+
+    // 3. correlation
+    let t = Instant::now();
+    let cor = pearson(&filtered, threads).unwrap();
+    timings.push(("cor".into(), t.elapsed().as_secs_f64()));
+
+    // 4. TOM
+    let t = Instant::now();
+    let _tom = tom_from_cor(
+        &cor,
+        6.0,
+        NetworkType::Unsigned,
+        TomType::Signed,
+        TomDenom::Min,
+        threads,
+    );
+    timings.push(("tom".into(), t.elapsed().as_secs_f64()));
+
+    // 5. full module detection (cor+TOM+hclust+cutree+merge)
+    let t = Instant::now();
+    let colors = blockwise_modules_single(
+        &filtered,
+        6.0,
+        NetworkType::Unsigned,
+        TomType::Signed,
+        TomDenom::Min,
+        30,
+        0.25,
+        2,
+        0.995,
+        threads,
+    );
+    timings.push(("module_detection_total".into(), t.elapsed().as_secs_f64()));
+
+    // 6. module eigengenes + module-trait
+    let t = Instant::now();
+    let trait_data = read_trait(traitpath).unwrap();
+    let traits = trait_data.1;
+    let tdata = trait_data.2;
+    // final module order (alphabetical non-grey)
+    let mut mods: Vec<String> = colors.iter().cloned().collect();
+    mods.sort();
+    mods.dedup();
+    let mods: Vec<String> = mods.into_iter().filter(|c| c != "grey").collect();
+    let k = mods.len();
+    let mut mes = Mat::<f64>::zeros(n, k);
+    for (mi, m) in mods.iter().enumerate() {
+        let midx: Vec<usize> = (0..g).filter(|&i| colors[i] == *m).collect();
+        let me = module_eigengene(&filtered, &midx);
+        for j in 0..n {
+            mes[(j, mi)] = me[j];
+        }
+    }
+    let (mt_cor, mt_p) = module_trait_cor(&mes, &tdata);
+    timings.push(("module_trait".into(), t.elapsed().as_secs_f64()));
+
+    // write outputs
+    let mut f = std::fs::File::create(format!("{outdir}/filtered_genes.txt")).unwrap();
+    for gi in &filtered_genes {
+        use std::io::Write;
+        writeln!(f, "{gi}").unwrap();
+    }
+    let mut f = std::fs::File::create(format!("{outdir}/module_colors.txt")).unwrap();
+    for (gi, c) in filtered_genes.iter().zip(colors.iter()) {
+        use std::io::Write;
+        writeln!(f, "{gi}\t{c}").unwrap();
+    }
+    write_mat(
+        &format!("{outdir}/module_trait_cor.tsv"),
+        &mt_cor,
+        &mods,
+        &traits,
+    );
+    write_mat(
+        &format!("{outdir}/module_trait_p.tsv"),
+        &mt_p,
+        &mods,
+        &traits,
+    );
+    let mut f = std::fs::File::create(format!("{outdir}/timings.tsv")).unwrap();
+    use std::io::Write;
+    writeln!(f, "step\tseconds").unwrap();
+    for (s, v) in &timings {
+        writeln!(f, "{s}\t{v:.4}").unwrap();
+    }
+    let mut f = std::fs::File::create(format!("{outdir}/module_sizes.tsv")).unwrap();
+    writeln!(f, "module\tsize").unwrap();
+    for m in &mods {
+        let sz = colors.iter().filter(|&c| c == m).count();
+        writeln!(f, "{m}\t{sz}").unwrap();
+    }
+
+    eprintln!(
+        "rust: {} genes -> {} MAD-top, {} modules, threads={}",
+        exp.n_genes(),
+        g,
+        mods.len(),
+        threads
+    );
+}
+
+fn write_mat(path: &str, m: &Mat<f64>, rows: &[String], cols: &[String]) {
+    use std::io::Write;
+    let mut f = std::fs::File::create(path).unwrap();
+    write!(f, "ID").unwrap();
+    for c in cols {
+        write!(f, "\t{c}").unwrap();
+    }
+    writeln!(f).unwrap();
+    for i in 0..m.nrows() {
+        write!(f, "{}", rows[i]).unwrap();
+        for j in 0..m.ncols() {
+            write!(f, "\t{:.6}", m[(i, j)]).unwrap();
+        }
+        writeln!(f).unwrap();
+    }
+}

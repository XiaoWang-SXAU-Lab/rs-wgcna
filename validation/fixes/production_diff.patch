+            index.get(s.as_str()).copied().ok_or_else(|| {
+                WgcnaError::InvalidInput(format!("missing trait sample '{s}'"))
+            })
+        })
+        .collect::<Result<_>>()?;
+    Ok(Mat::from_fn(order.len(), data.ncols(), |i, j| {
+        data[(order[i], j)]
